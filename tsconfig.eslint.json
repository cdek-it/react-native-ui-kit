{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist/eslint",
    "rootDir": "configs/eslint",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": false,
    "sourceMap": false
  },
  "files": ["configs/eslint/plugin.ts"],
  "exclude": ["node_modules"]
}
